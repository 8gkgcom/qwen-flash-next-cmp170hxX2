+static void
+_kgspSec2PostblTimingPutU32(NvU8 *pBuffer, NvU32 offset, NvU32 value)
+{
+    pBuffer[offset + 0] = (NvU8)(value >>  0);
+    pBuffer[offset + 1] = (NvU8)(value >>  8);
+    pBuffer[offset + 2] = (NvU8)(value >> 16);
+    pBuffer[offset + 3] = (NvU8)(value >> 24);
+}
