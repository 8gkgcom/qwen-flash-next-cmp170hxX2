# systemd EnvironmentFile: fill UUIDs, key and paths for this host.
GPU0_UUID=GPU-00000000-0000-0000-0000-000000000000
GPU1_UUID=GPU-00000000-0000-0000-0000-000000000001
MODEL_API_KEY=replace-with-your-key
SM80_PYTHON=/opt/qwen-flash/venv/bin/python
SM80_SITE=/media/nvme2/qwen-flash-sm80-data/native-root/usr/local/lib/python3.12/dist-packages
SM80_DATA_DIR=/media/nvme2/qwen-flash-sm80-data
MODEL_DIR=/media/nvme/models/dealignai--Qwen3.8-Flash-Next-ABLITERATED-NVFP4
CUDA_HOME=/usr/local/cuda-13.0
# Set to the actual nvidia/cu13 package directory if needed:
# SM80_NVIDIA_ROOT=/opt/qwen-flash/venv/lib/python3.12/site-packages/nvidia/cu13
MODEL_HOST=0.0.0.0
MODEL_PORT=8000
MAX_MODEL_LEN=262400
MAX_NUM_SEQS=8
GPU_MEMORY_UTILIZATION=0.95
PREFILL_TOKENS=8192
LONG_PREFILL_THRESHOLD=1280
MTP_TOKENS=4
