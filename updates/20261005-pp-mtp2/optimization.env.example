# Add to an already-working, version-matched Orca PP2/RAM launcher.
export Q38_RAM_COMPUTE_OPT=1
export Q38_RAM_PARALLEL=pp2
export Q38_PP_M3_HC=1
export Q38_HYBRID_DRAFT=0
export Q38_PCIE_IPC=0
export Q38_COMPACT_VOCAB=0
export Q38_WORKER_CUDA_LOADING=EAGER
export CUDA_MODULE_LOADING=EAGER
# Optional capture evidence; use a writable directory of your choice.
# export Q38_M3_EVIDENCE=/path/to/capture-evidence
# Merge the existing model preload with locally compiled SM80 QSA kernels first.
# export Q38_TRITON_PRELOAD_DIR=/path/to/merged-preload
